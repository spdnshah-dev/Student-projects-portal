# ---------------------------------------------------------------------------
# Learnbay Projects — environment template
# Copy to `.env` for local/test and fill in. NEVER commit a real .env.
# In production these are read from AWS Secrets Manager, not from a file, and
# the code that builds AI answers must not be able to read the secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (must have the `vector` extension / pgvector available).
# Test phase: Neon or Vercel Postgres. Production: AWS RDS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/learnbay_projects?schema=public"

# Direct (non-pooled) connection used by Prisma Migrate. On Neon this is the
# non-pooling URL; locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/learnbay_projects?schema=public"

# --- Auth ------------------------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Test phase only: enables the fixed-password seed accounts and skips the
# email verification code. MUST be "false" (or unset) in production.
FIXED_PASSWORD_TEST_MODE="true"

# --- File storage (certificates) ------------------------------------------
# Test phase: Vercel Blob.
BLOB_READ_WRITE_TOKEN=""
# Public host certificates are served from (a separate domain, never the app
# origin). Used for Next.js image remotePatterns.
NEXT_PUBLIC_BLOB_HOST=""

# Production (AWS): S3 + separate serving domain. Left blank in test phase.
AWS_REGION=""
S3_CERTIFICATES_BUCKET=""

# Malware scan for uploads. Set to a ClamAV-style endpoint that accepts the raw
# bytes and returns {"clean": true|false}. If unset, uploads are NOT scanned
# (a warning is logged); production also relies on the GuardDuty S3 scan.
CLAMAV_SCAN_URL=""

# --- AI assistant (Gemini, paid tier) --------------------------------------
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
# Safety valve: when the month's assistant spend reaches this cap (USD) the
# assistant replies that it is temporarily unavailable rather than overspend.
AI_MONTHLY_SPEND_CAP_USD="200"

# --- Public homepage link used by the assistant ----------------------------
# The one allowed outbound link: the Learnbay homepage / skill-gap test.
NEXT_PUBLIC_LEARNBAY_HOME_URL="https://www.learnbay.co"

# --- Link checker worker ---------------------------------------------------
# Per-request limits for the SSRF-safe daily link check.
LINK_CHECK_TIMEOUT_MS="10000"
LINK_CHECK_MAX_RESPONSE_BYTES="2000000"

# --- Rate limits (tunable without a code change) ---------------------------
RATE_LIMIT_AI_PER_MINUTE="5"
RATE_LIMIT_AI_PER_DAY="50"
RATE_LIMIT_FORM_PER_MINUTE="10"
